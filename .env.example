# ==============================================================================
# DuoVerse — Environment Variables Template
# ==============================================================================
# For Local Development: Copy to server/.env (or root .env)
# For Vercel Production: Add these under Vercel Dashboard → Project Settings → Environment Variables
# ==============================================================================

# ─── Server (Local Dev Only) ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Optional - falls back to in-memory seed data if MongoDB is absent) 
MONGODB_URI=mongodb://127.0.0.1:27017/duoverse_studio

# ─── Email / SMTP Credentials (Required for Real Email Delivery) ──────────────
# 1. MAIL_HOST: SMTP host (default: smtp.gmail.com)
MAIL_HOST=smtp.gmail.com

# 2. MAIL_PORT: SMTP port (587 for TLS/STARTTLS, 465 for SSL)
MAIL_PORT=587

# 3. MAIL_USER: The sending Gmail address (must match the Google account)
MAIL_USER=chaudharyhetvi158@gmail.com

# 4. MAIL_PASSWORD: A 16-character Google App Password (NOT your login password)
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
MAIL_PASSWORD=iajp karu rggd uivr

# 5. RECEIVER_EMAIL: Inbox where incoming contact form inquiries will be delivered
RECEIVER_EMAIL=chaudharyhetvi158@gmail.com

# 6. CONTACT_RECEIVER_EMAIL_2: (Optional) Second founder/team member inbox
CONTACT_RECEIVER_EMAIL_2=jyotijudal2006@gmail.com

# ─── Frontend API URL (Optional) ──────────────────────────────────────────────
# In production on Vercel, leave empty or unset — the app automatically uses relative '/api'
# In local development, the Vite dev server automatically proxies '/api' to port 5000
VITE_API_BASE_URL=/api
